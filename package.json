{
  "name": "addi",
  "icon": "resources/icon-bg.min.png",
  "displayName": "Addi",
  "description": "add more custom AI providers and models for your copilot",
  "version": "0.0.14",
  "publisher": "deepwn",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepwn/addi.git"
  },
  "homepage": "https://github.com/deepwn/addi",
  "bugs": {
    "url": "https://github.com/deepwn/addi/issues"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "keywords": [
    "AI",
    "ChatGPT",
    "Copilot",
    "OpenAI",
    "GPT-4",
    "GPT-3.5",
    "LLM",
    "Language Model",
    "Machine Learning",
    "Custom",
    "OAI"
  ],
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onLanguageModelChat:addi-provider",
    "onLanguageModelTool:addi_run_tool",
    "onLanguageModelTool:addi_list_tools",
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "contribLanguageModelToolSets",
    "languageModelCapabilities"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "config-export-icon": {
        "description": "Config Export Icon",
        "default": {
          "fontPath": "resources/bootstrap-icons.woff",
          "fontCharacter": "\\F29B"
        }
      },
      "config-import-icon": {
        "description": "Config Import Icon",
        "default": {
          "fontPath": "resources/bootstrap-icons.woff",
          "fontCharacter": "\\F358"
        }
      },
      "use-model-icon": {
        "description": "Use Model Icon",
        "default": {
          "fontPath": "resources/bootstrap-icons.woff",
          "fontCharacter": "\\F268"
        }
      },
      "magic-icon": {
        "description": "Magic Icon",
        "default": {
          "fontPath": "resources/bootstrap-icons.woff",
          "fontCharacter": "\\F675"
        }
      },
      "radar-icon": {
        "description": "Radar Icon",
        "default": {
          "fontPath": "resources/bootstrap-icons.woff",
          "fontCharacter": "\\F8CF"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "addiSidebar",
          "title": "Addi",
          "icon": "resources/icon.min.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "addiProviders",
        "contents": "Welcome to Addi!\n\nGet started by adding your first AI provider. Or first check [Docs](https://github.com/deepwn/addi)\n\n[Add Provider](command:addi.addProvider)\n\n[Import Config](command:addi.importConfig)"
      }
    ],
    "views": {
      "addiSidebar": [
        {
          "icon": "resources/icon.min.svg",
          "id": "addiProviders",
          "name": "Providers",
          "commands": [
            {
              "command": "addi.addProvider",
              "title": "Add Provider",
              "icon": "$(add)"
            }
          ]
        },
        {
          "id": "addiTools",
          "name": "Custom Tools",
          "icon": "$(tools)",
          "contextualTitle": "Addi Tools"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "addi.addProvider",
          "when": "view == addiProviders",
          "group": "navigation@1"
        },
        {
          "command": "addi.addTool",
          "when": "view == addiTools",
          "group": "navigation"
        },
        {
          "command": "addi.refreshTools",
          "when": "view == addiTools",
          "group": "navigation"
        },
        {
          "command": "addi.importConfig",
          "when": "view == addiProviders",
          "group": "navigation@2"
        },
        {
          "command": "addi.exportConfig",
          "when": "view == addiProviders",
          "group": "navigation@3"
        },
        {
          "command": "addi.openSettings",
          "when": "view == addiProviders",
          "group": "navigation@4"
        },
        {
          "command": "addi.refresh",
          "when": "view == addiProviders",
          "group": "navigation@0"
        }
      ],
      "panel/title": [
        {
          "command": "addi.showLogs",
          "when": "panel == output",
          "group": "navigation@3"
        },
        {
          "command": "addi.setLogLevel",
          "when": "panel == output",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "addi.addProvider",
          "when": "false"
        },
        {
          "command": "addi.editProvider",
          "when": "false"
        },
        {
          "command": "addi.deleteProvider",
          "when": "false"
        },
        {
          "command": "addi.addModel",
          "when": "false"
        },
        {
          "command": "addi.editModel",
          "when": "false"
        },
        {
          "command": "addi.deleteModel",
          "when": "false"
        },
        {
          "command": "addi.useModel",
          "when": "false"
        },
        {
          "command": "addi.editApiKey",
          "when": "false"
        },
        {
          "command": "addi.pullProviderModels",
          "when": "false"
        },
        {
          "command": "addi.copyProvider",
          "when": "false"
        },
        {
          "command": "addi.copyModel",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "addi.pullProviderModels",
          "when": "view == addiProviders && viewItem == provider",
          "group": "inline@0"
        },
        {
          "command": "addi.addModel",
          "when": "view == addiProviders && viewItem == provider",
          "group": "inline@1"
        },
        {
          "command": "addi.editApiKey",
          "when": "view == addiProviders && viewItem == provider",
          "group": "inline@2"
        },
        {
          "command": "addi.editProvider",
          "when": "view == addiProviders && viewItem == provider",
          "group": "modify@1"
        },
        {
          "command": "addi.copyProvider",
          "when": "view == addiProviders && viewItem == provider",
          "group": "modify@2"
        },
        {
          "command": "addi.deleteProvider",
          "when": "view == addiProviders && viewItem == provider",
          "group": "modify@99"
        },
        {
          "command": "addi.editModel",
          "when": "view == addiProviders && viewItem == model",
          "group": "modify@1"
        },
        {
          "command": "addi.copyModel",
          "when": "view == addiProviders && viewItem == model",
          "group": "modify@2"
        },
        {
          "command": "addi.deleteModel",
          "when": "view == addiProviders && viewItem == model",
          "group": "modify@99"
        },
        {
          "command": "addi.useModel",
          "when": "view == addiProviders && viewItem == model",
          "group": "inline"
        },
        {
          "command": "addi.editTool",
          "when": "view == addiTools && viewItem == tool",
          "group": "inline"
        },
        {
          "command": "addi.copyTool",
          "when": "view == addiTools && viewItem == tool",
          "group": "inline@1"
        },
        {
          "command": "addi.deleteTool",
          "when": "view == addiTools && viewItem == tool",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Addi Settings",
      "properties": {
        "addi.defaultMaxInputTokens": {
          "type": "number",
          "default": 4096,
          "description": "Max input tokens"
        },
        "addi.defaultMaxOutputTokens": {
          "type": "number",
          "default": 1024,
          "description": "Max output tokens"
        },
        "addi.defaultModelFamily": {
          "type": "string",
          "default": "Addi",
          "description": "Default model family to use for AI providers"
        },
        "addi.defaultModelVersion": {
          "type": "string",
          "default": "1.0.0",
          "description": "Default model version to use for AI providers"
        },
        "addi.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Whether to require confirmation before deleting providers or models"
        },
        "addi.saveConfigToSettingsSync": {
          "type": "boolean",
          "default": true,
          "description": "Whether to save the addi configuration to the vscode settings sync cloud"
        },
        "addi.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "warn",
          "description": "Minimum log level written to the Addi output channel"
        },
        "addi.sortRule": {
          "type": "string",
          "enum": [
            "none",
            "alphabet",
            "input tokens",
            "output tokens"
          ],
          "default": "none",
          "description": "Sort rule for providers and models"
        },
        "addi.sortTarget": {
          "type": "string",
          "enum": [
            "providers",
            "models",
            "both"
          ],
          "default": "both",
          "description": "Target to apply the sort rule"
        },
        "addi.mcpServer.executionMode": {
          "type": "string",
          "enum": [
            "local",
            "docker",
            "both"
          ],
          "default": "local",
          "description": "Execution mode for custom tools: 'local' (host shell), 'docker' (container), or 'both'."
        },
        "addi.mcpServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Addi MCP Server binary. If empty, defaults to ~/.addi/bin/addi-mcp-server."
        }
      }
    },
    "commands": [
      {
        "command": "addi.manage",
        "title": "Provider & Model Management",
        "shortTitle": "Management",
        "icon": "$(settings-gear)",
        "category": "Addi"
      },
      {
        "command": "addi.addProvider",
        "title": "Add Provider",
        "shortTitle": "Add",
        "icon": "$(add)",
        "category": "Addi"
      },
      {
        "command": "addi.editProvider",
        "title": "Edit Provider",
        "shortTitle": "Edit",
        "icon": "$(edit)",
        "category": "Addi"
      },
      {
        "command": "addi.deleteProvider",
        "title": "Delete Provider",
        "shortTitle": "Delete",
        "icon": "$(trash)",
        "category": "Addi"
      },
      {
        "command": "addi.addModel",
        "title": "Add Model",
        "shortTitle": "Add",
        "icon": "$(add)",
        "category": "Addi"
      },
      {
        "command": "addi.editModel",
        "title": "Edit Model",
        "shortTitle": "Edit",
        "icon": "$(edit)",
        "category": "Addi"
      },
      {
        "command": "addi.deleteModel",
        "title": "Delete Model",
        "shortTitle": "Delete",
        "icon": "$(trash)",
        "category": "Addi"
      },
      {
        "command": "addi.copyProvider",
        "title": "Copy Provider",
        "shortTitle": "Copy",
        "icon": "$(copy)",
        "category": "Addi"
      },
      {
        "command": "addi.copyModel",
        "title": "Copy Model",
        "shortTitle": "Copy",
        "icon": "$(copy)",
        "category": "Addi"
      },
      {
        "command": "addi.addTool",
        "title": "Add Tool",
        "shortTitle": "Add",
        "icon": "$(add)",
        "category": "Addi"
      },
      {
        "command": "addi.copyTool",
        "title": "Copy Tool",
        "shortTitle": "Copy",
        "icon": "$(copy)",
        "category": "Addi"
      },
      {
        "command": "addi.editTool",
        "title": "Edit Tool",
        "shortTitle": "Edit",
        "icon": "$(edit)",
        "category": "Addi"
      },
      {
        "command": "addi.deleteTool",
        "title": "Delete Tool",
        "shortTitle": "Delete",
        "icon": "$(trash)",
        "category": "Addi"
      },
      {
        "command": "addi.refreshTools",
        "title": "Refresh Tools",
        "shortTitle": "Refresh",
        "icon": "$(refresh)",
        "category": "Addi"
      },
      {
        "command": "addi.useModel",
        "title": "Use Model",
        "shortTitle": "Use",
        "icon": "$(use-model-icon)",
        "category": "Addi"
      },
      {
        "command": "addi.editApiKey",
        "title": "Edit API Key",
        "shortTitle": "Key",
        "icon": "$(key)",
        "category": "Addi"
      },
      {
        "command": "addi.pullProviderModels",
        "title": "Pull Models List",
        "shortTitle": "Pull Models",
        "icon": "$(radar-icon)",
        "category": "Addi"
      },
      {
        "command": "addi.exportConfig",
        "title": "Export Configuration",
        "shortTitle": "Export",
        "icon": "$(config-export-icon)",
        "category": "Addi"
      },
      {
        "command": "addi.importConfig",
        "title": "Import Configuration",
        "shortTitle": "Import",
        "icon": "$(config-import-icon)",
        "category": "Addi"
      },
      {
        "command": "addi.showLogs",
        "title": "Show Logs",
        "shortTitle": "Logs",
        "icon": "$(output)",
        "category": "Addi"
      },
      {
        "command": "addi.setLogLevel",
        "title": "Set Log Level",
        "shortTitle": "Log Level",
        "icon": "$(debug-breakpoint-log)",
        "category": "Addi"
      },
      {
        "command": "addi.openSettings",
        "title": "Open Settings",
        "shortTitle": "Settings",
        "icon": "$(settings-gear)",
        "category": "Addi"
      },
      {
        "command": "addi.refresh",
        "title": "Refresh Providers",
        "shortTitle": "Refresh",
        "icon": "$(refresh)",
        "category": "Addi"
      },
      {
        "command": "addi.triggerEditDetails",
        "title": "Edit Details",
        "shortTitle": "Edit",
        "icon": "$(edit)",
        "category": "Addi"
      },
      {
        "command": "addi.saveDetails",
        "title": "Save",
        "icon": "$(save)",
        "category": "Addi"
      },
      {
        "command": "addi.cancelDetails",
        "title": "Cancel",
        "icon": "$(close)",
        "category": "Addi"
      },
      {
        "command": "addi.verifyDetails",
        "title": "Auto-Detect Parameters",
        "icon": "$(magic-icon)",
        "category": "Addi"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "addi-provider",
        "displayName": "Addi",
        "managementCommand": "addi.manage"
      }
    ],
    "languageModelTools": [
      {
        "name": "addi_run_tool",
        "toolReferenceName": "addi_run",
        "displayName": "Addi Custom Tool Runner",
        "modelDescription": "Execute custom tools defined in Addi (e.g. scripts, http requests). Use this to extend capabilities with user-defined workflows.",
        "userDescription": "Execute custom tools defined in Addi",
        "icon": "$(tools)",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "description": "The name of the custom tool to execute"
            },
            "parameters": {
              "type": "object",
              "description": "The parameters required by the custom tool"
            }
          },
          "required": [
            "tool_name"
          ]
        },
        "tags": [
          "addi",
          "custom",
          "script"
        ]
      },
      {
        "name": "addi_list_tools",
        "toolReferenceName": "addi_list",
        "displayName": "Addi List Tools",
        "modelDescription": "List all available custom tools defined in Addi with their descriptions and parameters.",
        "userDescription": "List available Addi custom tools",
        "icon": "$(list-unordered)",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "tags": [
          "addi",
          "list"
        ]
      }
    ]
  },
  "scripts": {
    "test": "tsc -p . --outDir out && bun run package && vscode-test",
    "package": "bun build ./src/extension.ts --outdir ./dist --target node --format cjs --external vscode --sourcemap --minify",
    "watch": "bun build ./src/extension.ts --outdir ./dist --target node --format cjs --external vscode --sourcemap --watch",
    "compile": "bun build ./src/extension.ts --outdir ./dist --target node --format cjs --external vscode --sourcemap",
    "release": "bun run package && bunx @vscode/vsce package --baseImagesUrl https://raw.githubusercontent.com/deepwn/addi/refs/heads/main/ --no-yarn --no-dependencies",
    "debug": "code --extensionDevelopmentPath=.",
    "clean": "bun scripts/clean.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/deepseek": "^2.0.2",
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@ai-sdk/openai-compatible": "^2.0.2",
    "ai": "^6.0.5",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.2"
  }
}
